# ---------------------------------------------------------------- SMTP probe identity
# HELO name sent to mail servers. Empty = auto: reverse DNS of your public IP,
# else the PROBE_FROM domain, else the IP address literal.
PROBE_HELO=
# MAIL FROM used while probing (no email is ever sent from it).
# Must be on a real domain: many servers reject the empty sender <>.
# Do NOT use one of your 4 sending domains here.
PROBE_FROM=verify@mahmoudyassin.online

# ---------------------------------------------------------------- stage 6 switches
SMTP_ENABLED=true
SMTP_PORT=25
SMTP_TIMEOUT=20
# Skip domains hosted on Google Workspace / Microsoft 365 / Yahoo (marked Risky)
SKIP_HOSTED_BUSINESS=true

# ---------------------------------------------------------------- politeness (protects your IP)
SMTP_WORKERS=4
# seconds between two connections to the same mail provider (+ random 0..JITTER)
PER_MX_INTERVAL=8
PER_MX_JITTER=7
RCPT_DELAY_MIN=0.5
RCPT_DELAY_MAX=1.5
MAX_RCPT_PER_SESSION=10

# ---------------------------------------------------------------- greylisting / temporary errors
# seconds to wait before re-probing, and how many re-probes before marking Risky/Unknown
RETRY_DELAY=600
MAX_RETRIES=2

# stop SMTP probing for the rest of the run if >= BLOCK_RATIO of the last BLOCK_WINDOW servers block us
BLOCK_WINDOW=20
BLOCK_RATIO=0.5

# ---------------------------------------------------------------- dashboard
HOST=127.0.0.1
PORT=8765
